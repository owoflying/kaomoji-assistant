# 虚拟环境
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.pyd

# 运行时用户数据（最近使用 / 收藏 / 自定义颜文字 / 快捷短语，按用户生成）
data/user_state.json
data/user_kaomoji.json
data/user_triggers.json

# 日志
*.log

# 打包产物
build/
dist/
*.spec
# 打包时自动生成的图标（build.py 每次构建都会重新生成）
app.ico

# 编辑器 / IDE
.idea/
.vscode/
*.swp
.DS_Store
