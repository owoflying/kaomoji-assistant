# 虚拟环境
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.pyd

# 运行时用户数据（最近使用 / 收藏 / 自定义颜文字 / 快捷短语 / 插件私有配置，按用户生成）
data/user_state.json
data/user_kaomoji.json
data/user_triggers.json
data/plugin_settings/

# 自检产物（python main.py --diag）
diag.txt

# 项目内工具目录（本地记忆/会话数据）
.workbuddy/

# 日志
*.log

# 测试产物
.pytest_cache/
.coverage
htmlcov/

# 打包产物
build/
dist/
*.spec
# 打包时自动生成的图标（build.py 每次构建都会重新生成）
app.ico
# 构建期由 build.py 写入的 commit 短哈希（供打包态版本号回退）
core/_build_version.py

# 插件打包产物（手工打的分发 zip）
plugins/*.zip

# 编辑器 / IDE
.idea/
.vscode/
*.swp
.DS_Store

# 打包态自检产物
update_selftest.txt

# 调试残留
%LOG%
